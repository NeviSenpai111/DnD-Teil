  "classFeature": [
    {
      "name": "Defensive Stance",
      "source": "SRDLite",
      "className": "Warden",
      "classSource": "SRDLite",
      "level": 1,
      "entries": [
        "While you aren't wearing heavy armor, you can use a {@condition reaction|||reaction} to gain a +2 bonus to AC against one attack you can see."
      ]
    },
    {
      "name": "Martial Vigor",
      "source": "SRDLite",
      "className": "Warden",
      "classSource": "SRDLite",
      "level": 1,
      "entries": [
        "Your Hit Point maximum increases by an amount equal to your Constitution modifier (minimum 1). You also have proficiency in Strength and Constitution saving throws."
      ]
    },
    {
      "name": "Second Wind",
      "source": "SRDLite",
      "className": "Warden",
      "classSource": "SRDLite",
      "level": 2,
      "entries": [
        "Once per short rest, you can use a bonus action to regain {@dice 1d10} + your Warden level in hit points."
      ]
    },
    {
      "name": "Warden Path",
      "source": "SRDLite",
      "className": "Warden",
      "classSource": "SRDLite",
      "level": 3,
      "entries": [
        "You commit to a Warden Path that shapes your defensive style, granting features at 3rd level and beyond."
      ]
    },
    {
      "name": "Spellcasting",
      "source": "SRDLite",
      "className": "Channeler",
      "classSource": "SRDLite",
      "level": 1,
      "entries": [
        "You can cast channeler spells using Intelligence as your spellcasting ability. Your spell save DC is {@dc 8} + your proficiency bonus + your Intelligence modifier."
      ]
    },
    {
      "name": "Warden Stance",
      "source": "SRDLite",
      "className": "Warden",
      "classSource": "SRDLite",
      "level": 1,
      "entries": [
        "You adopt a stance that shapes how you fight. Choose one stance; you gain a second stance at 5th level."
      ]
    },
    {
      "name": "Expertise",
      "source": "SRDLite",
      "className": "Warden",
      "classSource": "SRDLite",
      "level": 1,
      "entries": [
        "Choose two of your skill proficiencies. Your proficiency bonus is doubled for any ability check you make that uses either of the chosen proficiencies."
      ]
    },
    {
      "name": "Unarmored Defense",
      "source": "SRDLite",
      "className": "Warden",
      "classSource": "SRDLite",
      "level": 1,
      "entries": [
        "While you aren't wearing any armor, your Armor Class equals 10 + your Dexterity modifier + your Constitution modifier. You can use a shield and still gain this benefit."
      ]
    }
  ],
